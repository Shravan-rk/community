# ---------------------------------------------------------------------------
# GRAMA SAHAY server configuration
# Copy this file to `.env` and replace every placeholder before running.
# Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Local development uses SQLite. For production switch to PostgreSQL:
#   provider "postgresql" in prisma/schema.prisma and set a postgres URL.
DATABASE_URL="file:./dev.db"

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-64-plus-character-secret
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# Comma separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Generic API rate limiting (window in ms / max requests per window).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Invite codes required to register non-citizen accounts.
# Generate long random values; rotate them after onboarding staff.
STAFF_INVITE_CODE=replace-with-a-random-staff-invite-code
ADMIN_INVITE_CODE=replace-with-a-random-admin-invite-code

# Seed credentials (development only). Never use in production.
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!123
SEED_ADMIN_PASSWORD=ChangeMe!123
SEED_STAFF_PASSWORD=ChangeMe!123
SEED_CITIZEN_PASSWORD=ChangeMe!123
